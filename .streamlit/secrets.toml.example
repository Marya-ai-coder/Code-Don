# Пример файла конфигурации секретов Streamlit
# Для реального использования скопируйте этот файл в .streamlit/secrets.toml
# и укажите ваши учетные данные.

# 1. YandexGPT (для работы в РФ)
# YANDEX_OAUTH_TOKEN = "y0_AgAAAA..."
# YANDEX_FOLDER_ID = "b1g..."

# 2. OpenAI API
# OPENAI_API_KEY = "sk-..."
