# Пример конфигурации секретов Streamlit для модели «Центр-инвест»
# Для использования скопируйте этот файл в .streamlit/secrets.toml

# Точка доступа и API-ключ модели «Центр-инвест» (настраивается разработчиком модуля генерации)
CENTRINVEST_API_KEY = "your_centrinvest_api_key_here"
# CENTRINVEST_API_URL = "https://api.centrinvest.ru/llm/generate"
